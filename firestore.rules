rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/workout/state {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['json', 'revision'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.revision is int
        && request.resource.data.revision == 1;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['json', 'revision'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000
        && request.resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
  }
}
